{
  "name": "codex-studio",
  "displayName": "Codex Studio (Unofficial)",
  "description": "A beautiful chat panel for the Codex CLI with per-folder session history, model and access pickers.",
  "version": "0.1.0",
  "publisher": "hangquan",
  "license": "MIT",
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#1e1b3a",
    "theme": "dark"
  },
  "keywords": [
    "codex",
    "codex cli",
    "ai",
    "chat",
    "agent",
    "openai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hangquan-zhao-private/codex-studio.git"
  },
  "bugs": {
    "url": "https://github.com/hangquan-zhao-private/codex-studio/issues"
  },
  "homepage": "https://github.com/hangquan-zhao-private/codex-studio#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexStudio",
          "title": "Codex Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codexStudio": [
        {
          "type": "webview",
          "id": "codexStudio.panel",
          "name": "Codex"
        }
      ]
    },
    "commands": [
      {
        "command": "codexStudio.newChat",
        "title": "New Chat",
        "category": "Codex Studio",
        "icon": "$(add)"
      },
      {
        "command": "codexStudio.showHistory",
        "title": "Show History",
        "category": "Codex Studio",
        "icon": "$(history)"
      },
      {
        "command": "codexStudio.askAboutSelection",
        "title": "Ask Codex About Selection",
        "category": "Codex Studio"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexStudio.newChat",
          "when": "view == codexStudio.panel",
          "group": "navigation@1"
        },
        {
          "command": "codexStudio.showHistory",
          "when": "view == codexStudio.panel",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "codexStudio.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Codex Studio",
      "properties": {
        "codexStudio.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Path to the codex CLI executable."
        },
        "codexStudio.sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "description": "Sandbox mode passed to codex."
        },
        "codexStudio.model": {
          "type": "string",
          "default": "",
          "description": "Model override (empty = use ~/.codex/config.toml)."
        },
        "codexStudio.reasoningEffort": {
          "type": "string",
          "default": "",
          "description": "Reasoning effort override (empty = use ~/.codex/config.toml)."
        },
        "codexStudio.networkAccess": {
          "type": "boolean",
          "default": false,
          "description": "Allow network access in workspace-write sandbox."
        },
        "codexStudio.sessionsDir": {
          "type": "string",
          "default": "",
          "description": "Codex sessions directory (empty = ~/.codex/sessions)."
        }
      }
    }
  },
  "scripts": {
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "build:web": "vite build --config webview-ui/vite.config.ts",
    "build": "npm run build:web && npm run build:ext",
    "watch:ext": "npm run build:ext -- --watch",
    "watch:web": "vite build --config webview-ui/vite.config.ts --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview-ui",
    "package": "npm run build && vsce package --no-dependencies",
    "publish": "npm run build && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
